---
// Every page's chrome: scroll progress bar, top nav, language switch and
// theme toggle. Plain HTML plus two small scripts (no React).
import { languageNames, languages, site } from '@/content';

interface Props { lang: string; nav: Record<string, string>; themeLabel: string }
const { lang, nav, themeLabel } = Astro.props;
const rest = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '');
---
<div class="progress" style="transform:scaleX(0)"></div>
<nav class="nav">
  <a href={`/${lang}/`} class="logo">LENZ<span>LAB</span></a>
  <div class="nav-links">
    <a href={`/${lang}/#problems`}>{nav.problems}</a>
    <a href={`/${lang}/#services`}>{nav.services}</a>
    <a href={`/${lang}/#integrations`}>{nav.integrations}</a>
    <a href={`/${lang}/#work`}>{nav.work}</a>
    <span class="lang-switch">
      {languages.map((l) => (
        <a href={`/${l}${rest || '/'}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
          <span class="full">{languageNames[l]}</span>
          <span class="short">{l.toUpperCase()}</span>
        </a>
      ))}
    </span>
    <button type="button" class="theme-toggle" aria-label={themeLabel} title={themeLabel}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
    <a href={`mailto:${site.email}`} class="nav-cta">{nav.contact}</a>
  </div>
</nav>
<slot />

<script>
  // Scroll progress bar, smoothed like motion's useSpring(scrollYProgress,
  // { stiffness: 120, damping: 30 }).
  const bar = document.querySelector<HTMLElement>('.progress');
  if (bar) {
    let x = 0;
    let v = 0;
    let last = 0;
    let raf = 0;
    const target = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    };
    const step = (now: number) => {
      const goal = target();
      let dt = Math.min(0.064, (now - (last || now)) / 1000);
      last = now;
      // Integrate in small sub-steps for stability.
      while (dt > 0) {
        const h = Math.min(dt, 0.004);
        v += (-120 * (x - goal) - 30 * v) * h;
        x += v * h;
        dt -= h;
      }
      if (Math.abs(v) < 0.01 && Math.abs(goal - x) < 0.001) {
        x = goal;
        v = 0;
        raf = 0;
        last = 0;
      } else {
        raf = requestAnimationFrame(step);
      }
      bar.style.transform = x >= 1 ? 'none' : `scaleX(${x})`;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(step); };
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick);
    kick();
  }

  // Light by default; dark when the OS asks for it, unless the visitor picked
  // a theme here. The choice is stored per browser and applied before paint by
  // the inline script in the layout.
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (btn) {
    const svg = btn.querySelector('svg')!;
    const SUN = svg.innerHTML;
    const MOON = '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>';
    const root = document.documentElement;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    let dark = root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches;
    const render = () => {
      svg.innerHTML = dark ? MOON : SUN;
      btn.setAttribute('aria-pressed', String(dark));
    };
    render();
    mq.addEventListener('change', (e) => { if (!root.dataset.theme) { dark = e.matches; render(); } });
    btn.addEventListener('click', () => {
      const next = dark ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      dark = !dark;
      render();
    });
  }
</script>
